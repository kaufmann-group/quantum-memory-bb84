   "source": [
    "## FGGNP Attack\n",
    "\n",
    "In the attack outlined by Fuchs et al., Eve couples two probes to the signal. The QBER is give as `qber = disturbance`. Note that from Eve's measurement  \n",
    "\n",
    "Eve couples two probes to the signal. This run sets the attack disturbance to 10%. Keep it as the reference for the three noisy runs."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "5362b00e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Alice's sifted key: 11011011111011011010001101011\n",
      "Bob's sifted key:   10011011011011011011001101011\n",
      "Eve's guesses:      00011011101111011010000101010\n",
      "QBER: 3/29 = 10.3%\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 3323x1095 with 3 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "run(attack=FGGNPAttack(disturbance=0.10))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "b352f8a7-3415-4526-a884-f89d9c6f1bb0",
   "metadata": {},
   "outputs": [],
   "source": [
    "def run_fggnp(channel_e, channel_f, sifted_key_index=0, disturbance=0.10, number_bits=48, seed=secrets.randbits(128)):\n",
    "    bb84 = BB84(number_bits=number_bits, seed=seed)\n",
    "    attack = FGGNPAttack(disturbance=disturbance, seed=seed)\n",
    "\n",
    "    # Each channel acts on its named Eve probe after the attack interaction.\n",
    "    noise = ProbeNoise({\"E\": channel_e, \"F\": channel_f})\n",
    "    alice, bob = bb84.key_generation(attack=attack, memory_channel=noise, memory_targets=list(noise.channels), record_rounds=range(bb84.number_bits))\n",
    "\n",
    "    sifted_rounds = np.flatnonzero(bb84.sifted_mask) # find original transmission round that produced this sifted bit\n",
    "    if len(sifted_rounds) == 0:\n",
    "        raise ValueError(\"No sifted bits\")\n",
    "\n",
    "    round_index = int(sifted_rounds[sifted_key_index])\n",
    "    basis = bb84.alice_bases[round_index]\n",
    "\n",
    "    eve = bb84.eve_guesses()\n",
    "\n",
    "    def bits(values):\n",
    "        return \"\".join(\"?\" if bit == UNKNOWN else str(bit) for bit in values)\n",
    "\n",
    "    print(\"Alice's sifted key:\", bits(alice))\n",
    "    print(\"Bob's sifted key:  \", bits(bob))\n",
    "    print(\"Eve's guesses:     \", bits(eve))\n",
    "\n",
    "    print(f\"QBER: {np.count_nonzero(alice != bob)}/{len(alice)} = {bb84.qber():.1%}\")\n",
    "\n",
    "    bb84.display(round_index=round_index, title=f\"FGGNP Attack | Sifted bit {sifted_key_index} | {basis} basis\")"
   ]
  },
  {
